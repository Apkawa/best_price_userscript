{
  "version": "0.5.22",
  "author": "Apkawa",
  "homepage": "https://github.com/Apkawa/best_price_userscript",
  "repository": "https://github.com/Apkawa/best_price_userscript",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Apkawa/best_price_userscript/issues"
  },
  "readme": "README.md",
  "devDependencies": {
    "@babel/plugin-proposal-pipeline-operator": "^7.29.7",
    "@biomejs/biome": "2.4.16",
    "@happy-dom/global-registrator": "^20.9.0",
    "@playwright/test": "^1.60.0",
    "@types/bun": "latest",
    "@types/eslint": "^9.6.1",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/glob": "^9.0.0",
    "@types/jsdom-global": "^3.0.7",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@types/node-fetch": "^2.6.13",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "camoufox-js": "^0.10.2",
    "chalk": "^5.6.2",
    "cloakbrowser": "^0.3.31",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-userscripts": "^0.5.6",
    "fromentries": "^1.3.2",
    "glob": "^13.0.6",
    "happy-dom": "^20.10.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "jsdom-global": "^3.0.2",
    "node-fetch": "^3.3.2",
    "path-browserify": "^1.0.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "process": "^0.11.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "type-fest": "^5.7.0",
    "typescript": "^6.0.3",
    "typesync": "^0.14.3"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "build": "bun build/build-userscripts.ts",
    "build:watch": "BUN_OPTIONS='--watch' WATCH=1 npm run build",
    "prepare": "husky",
    "synctypes": "typesync && npm i",
    "format": "biome format --write src/ tests/ build/",
    "format:check": "biome lint src/ tests/ build/ --fix",
    "test": "bun run test:unit",
    "test:unit": "npm run type && node --import tsx --test --test src/**/*.test.ts --test tests/unit/**/*.test.ts",
    "test:jsdom": "npm run type && node --import tsx --test tests/jsdom/**/*.test.ts",
    "test:jsdom:snapshot-sync": "node --import tsx ./tests/jsdom/snapshot_sync.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:coverage": "npm run test -- --experimental-test-coverage",
    "test:coverage:lcov": "npm run test -- --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info",
    "type": "tsc",
    "lint": "biome check src/ --fix --error-on-warnings ",
    "check": "bun run test && bun lint && bun format:check",
    "pre-commit": "npm run format && npm run lint && npm run build && git add -A dist/ && git add -u"
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=22"
  },
  "husky": {
    "hooks": {
      "pre-commit": "bun run pre-commit"
    }
  },
  "browserslist": [
    "last 2 years",
    "> 1%",
    "not dead"
  ],
  "babel": {
    "plugins": [
      [
        "@babel/plugin-proposal-pipeline-operator",
        {
          "proposal": "minimal"
        }
      ]
    ]
  },
  "prettier": {
    "bracketSpacing": false,
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 100
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es6": true,
      "es2017": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@typescript-eslint/recommended-requiring-type-checking"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "tsconfig.json",
      "tsconfigRootDir": "."
    },
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "off",
      "max-len": [
        "error",
        {
          "code": 100
        }
      ]
    }
  },
  "name": "best_price_userscript",
  "private": true,
  "dependencies": {
    "rxjs": "^6.5.1"
  }
}
